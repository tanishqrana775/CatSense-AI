# CatSense AI Environment Configuration Example
# Copy to .env for local development

# Flask Settings
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Database Connection (Neon / Supabase / PostgreSQL or omit for local SQLite)
# Example PostgreSQL: postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Python & TensorFlow Memory Optimization
PYTHON_VERSION=3.12.7
TF_CPP_MIN_LOG_LEVEL=2
OMP_NUM_THREADS=1
